# Scratch AI Detector - Production & Development Environment Configuration

# Server Port
PORT=3000

# Environment: production | development | test
NODE_ENV=production

# Database path (SQLite file path or :memory:)
DATABASE_PATH=./data/scratch_ai_detector.db

# JWT Secret for Admin authentication
# IMPORTANT: Generate a strong, unpredictable random key for production!
# e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-very-long-random-secret-in-production-2026

# Admin Session Expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (used when the database is created for the first time)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_on_first_launch!

# Allowed CORS origins (* for permissive, or specific comma-separated URLs like https://scratch.mit.edu,https://yourdomain.com)
CORS_ORIGIN=*
