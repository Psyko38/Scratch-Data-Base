# Cao AI Detector - Environment Configuration

# Server Port
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# Database path (SQLite file path or :memory:)
DATABASE_PATH=./data/scratch_ai_detector.db

# JWT Secret for Admin authentication (generate a strong random secret in production)
JWT_SECRET=cao-scratch-ai-detector-secret-key-change-in-prod-2026

# Admin Session Expiry
JWT_EXPIRES_IN=7d

# Default Administrator Credentials (used when database is first created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPass123!

# Allowed CORS origins (* or comma-separated list of origins)
CORS_ORIGIN=*
